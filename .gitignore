# Ambiente Python del core, e l'interprete che uv installa dentro al progetto
# (sta qui e non in AppData per non dipendere da cartelle sincronizzate su cloud)
core/.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Output degli spike: audio e trascrizioni di prova
spikes/out/

# Modelli e binari scaricati a runtime, non versionati
models/
vendor/
*.gguf
*.onnx

# Dati dell'utente: registrazioni, screenshot, database
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Segreti
.env
.env.local

# UI
ui/node_modules/
ui/dist/
ui/release/

# Output del packaging: eseguibile PyInstaller del core (scripts/build-core.ps1)
# e cartella di lavoro intermedia. Centinaia di MB, ricostruibili in ogni
# momento con `npm run dist` — vedi .claude/project/10-packaging.md.
/dist/
/build/

# Sistema
Thumbs.db
.DS_Store
